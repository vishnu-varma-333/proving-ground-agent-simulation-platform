# Copy to .env.local (gitignored) and fill in real values. Never commit
# actual keys.

# Required: at least one Gemini API key for the reference agent.
GEMINI_API_KEY=

# Optional: additional keys the agent rotates to when one hits its quota
# (dev-time workaround for the free tier's daily cap - see DECISIONS.md).
# Either spelling works: GEMINI_API_KEY_2 or GEMINI_API_KEY2.
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Optional: where the mock services' SQLite files live. Defaults to ./data.
# PG_DATA_DIR=data
